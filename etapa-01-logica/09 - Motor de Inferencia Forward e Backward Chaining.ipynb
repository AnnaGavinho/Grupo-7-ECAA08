    "        antecedentes=[\"TT-201_HIGH\", \"M-201_OFF\"],\n",
    "        consequente=\"SUPER_AQUECIMENTO_AMENDOIM\",\n",
    "        severidade=9,\n",
    "        descricao=\"Esteira parada com alta temperatura no forno provoca queima imediata da carga\"\n",
    "    ))\n",
    "    \n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-102\",\n",
    "        antecedentes=[\"TS-201_ON\", \"FS-201_LOW\"],\n",
    "        consequente=\"FALHA_COMBUSTAO_FORNO\",\n",
    "        severidade=9,\n",
    "        descricao=\"Chama ativa sem exaustao de gases gera risco de explosao\"\n",
    "    ))\n",
    "    \n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-103\",\n",
    "        antecedentes=[\"SUPER_AQUECIMENTO_AMENDOIM\"],\n",
    "        consequente=\"RISCO_INCENDIO_TORRA\",\n",
    "        severidade=10,\n",
    "        descricao=\"Superaquecimento de graos desencadeia risco critico de incendio\"\n",
    "    ))\n",
    "    \n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-104\",\n",
    "        antecedentes=[\"RISCO_INCENDIO_TORRA\"],\n",
    "        consequente=\"TRIP_CORTE_GAS_XV201\",\n",
    "        severidade=10,\n",
    "        descricao=\"Intertravamento critico: Desenergizacao imediata da valvula de combustivel\",\n",
    "        pop=\"POP-TOR-01: Fechar XV-201, exaustor FS-201 no maximo e soar sinaleiro ALM-201\"\n",
    "    ))\n",
    "    \n",
    "    # --- SETOR 400: Compactacao, Inspecao e Embalagem (CLP 04) ---\n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-201\",\n",
    "        antecedentes=[\"MD-401_METAL\"],\n",
    "        consequente=\"LOTE_CONTAMINADO_METAL\",\n",
    "        severidade=10,\n",
    "        descricao=\"Detector de metais acusa particula ferrosa ou nao-ferrosa no doce\"\n",
