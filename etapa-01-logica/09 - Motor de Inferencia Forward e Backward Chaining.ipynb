   "source": [
    "## 7. Benchmark de Desempenho no Scan Cycle do SCADA-Core\n",
    "\n",
    "Mensuramos o tempo de execução executando $10.000$ ciclos contínuos de inferência para certificar a viabilidade em tempo real ($< 10\\text{ ms}$)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "N_CICLOS = 10000\n",
    "fatos_teste = {\"TT-201_HIGH\", \"M-201_OFF\", \"TS-201_ON\"}\n",
    "\n",
    "# Benchmark Forward Chaining\n",
    "t0 = time.time()\n",
    "for _ in range(N_CICLOS):\n",
    "    _ = motor_pacoca.forward_chaining(fatos_teste)\n",
    "t_total_fw = time.time() - t0\n",
    "t_medio_fw = (t_total_fw / N_CICLOS) * 1e6  # em microsegundos\n",
    "\n",
    "# Benchmark Backward Chaining\n",
    "t0 = time.time()\n",
    "for _ in range(N_CICLOS):\n",
    "    _ = motor_pacoca.backward_chaining(\"TRIP_CORTE_GAS_XV201\", fatos_teste)\n",
    "t_total_bw = time.time() - t0\n",
    "t_medio_bw = (t_total_bw / N_CICLOS) * 1e6\n",
    "\n",
    "df_bench = pd.DataFrame([\n",
    "    {\n",
    "        \"Algoritmo de Inferência\": \"Forward Chaining (Tempo Real / Scan Cycle)\",\n",
    "        \"Total de Ciclos\": N_CICLOS,\n",
    "        \"Tempo Total (s)\": f\"{t_total_fw:.4f}\",\n",
    "        \"Tempo Médio por Ciclo (µs)\": f\"{t_medio_fw:.2f}\",\n",
    "        \"Frequência Equivalente (Hz)\": f\"{1e6 / t_medio_fw:,.0f} scans/s\"\n",
    "    },\n",
    "    {\n",
    "        \"Algoritmo de Inferência\": \"Backward Chaining (Causa-Raiz / Árvore de Prova)\",\n",
    "        \"Total de Ciclos\": N_CICLOS,\n",
    "        \"Tempo Total (s)\": f\"{t_total_bw:.4f}\",\n",
    "        \"Tempo Médio por Ciclo (µs)\": f\"{t_medio_bw:.2f}\",\n",
    "        \"Frequência Equivalente (Hz)\": f\"{1e6 / t_medio_bw:,.0f} queries/s\"\n",
    "    }\n",
    "])\n",
    "\n",
    "exibir_tabela(df_bench, \"Benchmark de Desempenho do Motor de Inferência\")"
   ]
