    "        pop=\"POP-DOS-03: Inibir abertura da valvula XV-301 e solicitar recalibracao das balancas\"\n",
    "    ))\n",
    "    \n",
    "    return motor\n",
    "\n",
    "motor_pacoca = criar_motor_fabrica_pacoca()\n",
    "print(f\"Base de Conhecimento carregada com {len(motor_pacoca.regras)} regras especialistas.\")"
