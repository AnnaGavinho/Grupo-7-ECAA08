    "    \n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-202\",\n",
    "        antecedentes=[\"LOTE_CONTAMINADO_METAL\", \"PS-402_OK\"],\n",
    "        consequente=\"ACIONAMENTO_SOPRO_XV401\",\n",
    "        severidade=8,\n",
    "        descricao=\"Ejeção pneumatica nominal do lote contaminado\",\n",
    "        pop=\"POP-REJ-01: Sopro pneumatico acionado para descarte na caixa de nao-conformes\"\n",
    "    ))\n",
    "    \n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-203\",\n",
    "        antecedentes=[\"LOTE_CONTAMINADO_METAL\", \"PS-402_LOW\"],\n",
    "        consequente=\"FALHA_EJECAO_PNEUMATICA\",\n",
    "        severidade=10,\n",
    "        descricao=\"Pressao pneumatica insuficiente (<6 bar) impede sopro de descarte\"\n",
    "    ))\n",
    "    \n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-204\",\n",
    "        antecedentes=[\"FALHA_EJECAO_PNEUMATICA\"],\n",
    "        consequente=\"PARADA_EMERGENCIA_ESTEIRA_M401\",\n",
    "        severidade=10,\n",
    "        descricao=\"Bloqueio imediato da esteira de embalagem para evitar expedicao de produto contaminado\",\n",
    "        pop=\"POP-SEG-01: Parar esteira M-401, reter lote e emitir alerta sonoro para operador\"\n",
    "    ))\n",
    "    \n",
    "    # --- SETOR 300: Dosagem e Moagem (CLP 03) ---\n",
    "    motor.adicionar_regra(Regra(\n",
    "        id=\"R-301\",\n",
    "        antecedentes=[\"WT-301_ERR\"],\n",
    "        consequente=\"DESVIO_RECEITA_PACOCA\",\n",
