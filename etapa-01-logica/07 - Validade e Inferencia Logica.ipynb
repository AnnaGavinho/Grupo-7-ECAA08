   "source": [
    "import itertools\n",
    "from typing import List, Dict, Callable, Tuple, Any\n",
    "import pandas as pd\n",
    "\n",
    "def exibir_tabela(dados, titulo=\"\"):\n",
    "    \"\"\"Exibe tabelas formatadas de forma amigavel no Jupyter ou no Terminal.\"\"\"\n",
    "    if titulo:\n",
    "        print(f\"\\n=== {titulo} ===\")\n",
    "    if isinstance(dados, pd.DataFrame):\n",
    "        try:\n",
    "            from IPython.display import display\n",
    "            display(dados)\n",
    "        except Exception:\n",
    "            print(dados.to_string(index=False))\n",
    "    else:\n",
    "        df = pd.DataFrame(dados)\n",
    "        try:\n",
    "            from IPython.display import display\n",
    "            display(df)\n",
    "        except Exception:\n",
    "            print(df.to_string(index=False))\n",
    "\n",
    "print(\"[OK] Ambiente de Inferência Lógica e Prova Formal (Grupo 7 - Fábrica de Paçoca) inicializado com sucesso.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Motor Computacional de Validação de Argumentos Lógicos\n",
    "\n",
    "Formalmente, um argumento $P_1, P_2, \\dots, P_k \\vdash C$ é **válido** se e somente se a implicação lógica:\n",
    "$$\\Phi = (P_1 \\land P_2 \\land \\dots \\land P_k) \\rightarrow C$$\n",
    "for avaliada como **Verdadeira ($1$)** em todas as $2^n$ combinações de variáveis binárias (Tautologia)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ValidadorInferencias:\n",
    "    @staticmethod\n",
    "    def avaliar_argumento(\n",
    "        variaveis: List[str],\n",
    "        premissas: List[Tuple[str, Callable[[Dict[str, bool]], bool]]],\n",
    "        conclusao: Tuple[str, Callable[[Dict[str, bool]], bool]]\n",
    "    ) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Avalia exaustivamente a validade formal de um argumento logico atraves de tabela-verdade completa.\n",
    "        \n",
    "        Parametros:\n",
    "            variaveis: Lista com os nomes simbolicos das proposicoes.\n",
    "            premissas: Lista de tuplas (nome_premissa, funcao_booleana).\n",
    "            conclusao: Tupla (nome_conclusao, funcao_booleana).\n",
    "            \n",
    "        Retorna:\n",
    "            Dicionario contendo status de validade, total de contraexemplos e DataFrame com a tabela.\n",
    "        \"\"\"\n",
    "        tabela = []\n",
    "        contraexemplos = []\n",
    "        \n",
    "        nome_conc, fn_conc = conclusao\n",
    "        nomes_prem = [nome for nome, _ in premissas]\n",
    "        \n",
    "        for combo in itertools.product([False, True], repeat=len(variaveis)):\n",
    "            estado = dict(zip(variaveis, combo))\n",
    "            \n",
    "            # Avalia cada premissa individualmente\n",
    "            vals_premissas = [fn(estado) for _, fn in premissas]\n",
    "            conjuncao_premissas = all(vals_premissas)\n",
    "            \n",
    "            # Avalia a conclusao\n",
    "            val_conclusao = fn_conc(estado)\n",
    "            \n",
    "            # Implicacao Formal: (P1 and P2 and ... and Pk) -> C  === (not P) or C\n",
    "            implicacao = (not conjuncao_premissas) or val_conclusao\n",
    "            \n",
    "            # Contraexemplo: premissas simultaneamente satisfeitas, mas conclusao falsa\n",
    "            if conjuncao_premissas and not val_conclusao:\n",
    "                contraexemplos.append(estado)\n",
    "                \n",
    "            row = {**estado}\n",
    "            for i, nome in enumerate(nomes_prem):\n",
    "                row[f\"P{i+1}: {nome}\"] = vals_premissas[i]\n",
    "            row[\"P_Global (Conjunção)\"] = conjuncao_premissas\n",
    "            row[f\"Conclusão: {nome_conc}\"] = val_conclusao\n",
    "            row[\"Validade (P -> C)\"] = implicacao\n",
    "            \n",
    "            tabela.append(row)\n",
    "            \n",
    "        df_resultado = pd.DataFrame(tabela)\n",
    "        argumento_valido = len(contraexemplos) == 0\n",
    "        \n",
    "        return {\n",
    "            \"Valido\": argumento_valido,\n",
    "            \"Classificacao\": \"VÁLIDO (Tautologia de Inferência)\" if argumento_valido else \"INVÁLIDO (Falácia / Risco Operacional)\",\n",
    "            \"Total_Estados\": len(tabela),\n",
    "            \"Total_Contraexemplos\": len(contraexemplos),\n",
    "            \"Contraexemplos\": contraexemplos,\n",
    "            \"Tabela_Verdade\": df_resultado\n",
    "        }\n",
    "\n",
    "print(\"[OK] Classe ValidadorInferencias compilada com sucesso.\")"
   ]
  },
