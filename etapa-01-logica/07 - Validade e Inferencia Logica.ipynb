    "## 7. Motor de Auditoria Global da Matriz de Segurança (*Conflict-Free Matrix*)\n",
    "\n",
    "Avaliamos todos os atuadores críticos da Fábrica de Paçoca (`XV-201`, `M-101`, `M-301`, `M-401`, `XV-401`) para certificar que as equações de comando garantem:\n",
    "$$\\text{Cmd\\_Liga}(A) \\land \\text{Cmd\\_Desliga}(A) \\equiv \\mathbf{0} \\quad (\\text{Sem Conflitos})$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "atuadores_criticos = {\n",
    "    \"XV-201 (Válvula Gás Forno Torra)\": {\n",
    "        \"vars\": ['t2', 'c1', 'm2', 'f2', 'p_gas_low'],\n",
    "        \"cmd_liga\": lambda s: s['f2'] and s['c1'] and not s['p_gas_low'],\n",
    "        \"cmd_desliga\": lambda s: s['t2'] or (s['c1'] and not s['m2']) or s['p_gas_low']\n",
    "    },\n",
    "    \"M-101 (Motor Peneira Entrada)\": {\n",
    "        \"vars\": ['u1', 'q1', 'e1', 'cmd_partida'],\n",
    "        \"cmd_liga\": lambda s: s['cmd_partida'] and not s['u1'] and not s['q1'] and not s['e1'],\n",
    "        \"cmd_desliga\": lambda s: s['u1'] or s['q1'] or s['e1']\n",
    "    },\n",
    "    \"M-301 (Motor Moinho de Amendoim)\": {\n",
    "        \"vars\": ['w1', 'w2', 'w3', 'e1', 'cmd_moinho'],\n",
    "        \"cmd_liga\": lambda s: s['cmd_moinho'] and s['w1'] and s['w2'] and s['w3'] and not s['e1'],\n",
    "        \"cmd_desliga\": lambda s: s['e1'] or not (s['w1'] and s['w2'] and s['w3'])\n",
    "    },\n",
    "    \"M-401 (Esteira Embalagem)\": {\n",
    "        \"vars\": ['d1', 'e2', 'cmd_auto'],\n",
    "        \"cmd_liga\": lambda s: s['cmd_auto'] and not s['d1'] and not s['e2'],\n",
    "        \"cmd_desliga\": lambda s: s['d1'] or s['e2']\n",
    "    }\n",
    "}\n",
    "\n",
    "relatorio_auditoria = []\n",
    "for tag, cfg in atuadores_criticos.items():\n",
    "    conflitos = 0\n",
    "    total_estados = 2 ** len(cfg[\"vars\"])\n",
    "    for combo in itertools.product([False, True], repeat=len(cfg[\"vars\"])):\n",
    "        st = dict(zip(cfg[\"vars\"], combo))\n",
    "        if cfg[\"cmd_liga\"](st) and cfg[\"cmd_desliga\"](st):\n",
    "            conflitos += 1\n",
    "            \n",
    "    relatorio_auditoria.append({\n",
    "        \"Atuador ISA-5.1\": tag,\n",
    "        \"Variáveis\": len(cfg[\"vars\"]),\n",
    "        \"Estados Analisados\": total_estados,\n",
    "        \"Conflitos (Liga & Desliga = 1)\": conflitos,\n",
    "        \"Status Consistência\": \"CONSISTENTE (Fail-Safe OK)\" if conflitos == 0 else \"INCONSISTENTE (Conflito!)\"\n",
    "    })\n",
    "\n",
    "exibir_tabela(relatorio_auditoria, \"Auditoria Global de Consistência da Matriz de Segurança (SCADA-Core)\")"
   ]
  },
  {
