    "## 6. Prova por Redução ao Absurdo (*Reductio ad Absurdum* / RAA)\n",
    "\n",
    "Provamos que a ocorrência de emergência no Setor 100 (`ESD-100` / $e_1$) torna **logicamente impossível** o motor da peneira de entrada (`M-101` / $m_1$) permanecer ligado sob a regra de intertravamento:\n",
    "$$\\Phi = (e_1 \\rightarrow \\neg m_1) \\land e_1 \\land m_1 \\equiv \\mathbf{0} \\quad (\\text{Contradição})$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def prova_por_absurdo(variaveis: List[str], premissas: List[Callable], conclusao: Callable) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Testa se a conjuncao das premissas com a negacao da conclusao gera contradicao absoluta (sempre False).\n",
    "    \"\"\"\n",
    "    tabela_absurdo = []\n",
    "    \n",
    "    for combo in itertools.product([False, True], repeat=len(variaveis)):\n",
    "        st = dict(zip(variaveis, combo))\n",
    "        \n",
    "        # Premissas verdadeiras e Conclusao Falsa (Tentativa de Violacao de Seguranca)\n",
    "        condicao_violacao = all([p(st) for p in premissas]) and (not conclusao(st))\n",
    "        tabela_absurdo.append({**st, \"Estado_Violacao_Possivel\": condicao_violacao})\n",
    "        \n",
    "    df = pd.DataFrame(tabela_absurdo)\n",
    "    eh_contradicao = not df[\"Estado_Violacao_Possivel\"].any()\n",
    "    \n",
    "    return {\n",
    "        \"Prova_Concluida\": eh_contradicao,\n",
    "        \"Classificacao\": \"CONTRADIÇÃO COMPROVADA (Ausência Absoluta de Risco)\" if eh_contradicao else \"VULNERABILIDADE DETECTADA\",\n",
    "        \"Tabela\": df\n",
    "    }\n",
    "\n",
    "# Teste formal para a Parada de Emergencia do Setor 100\n",
    "vars_esd = ['e1', 'm1']\n",
    "prem_esd = [\n",
    "    lambda s: (not s['e1']) or (not s['m1']), # e1 -> not m1\n",
    "    lambda s: s['e1']                          # e1 ativo\n",
    "]\n",
    "conc_esd = lambda s: not s['m1']               # Conclusao segura: not m1\n",
    "\n",
    "res_absurdo = prova_por_absurdo(vars_esd, prem_esd, conc_esd)\n",
    "\n",
    "print(\"===========================================================\")\n",
    "print(\" PROVA POR REDUÇÃO AO ABSURDO (PARADA DE EMERGÊNCIA ESD-100) \")\n",
    "print(\"===========================================================\")\n",
    "print(f\"Resultado: {res_absurdo['Classificacao']}\")\n",
    "print(f\"Probabilidade Lógica de Falha Silenciosa: {'0.00% (Impossível)' if res_absurdo['Prova_Concluida'] else 'ALTA'}\")\n",
    "\n",
    "exibir_tabela(res_absurdo['Tabela'], \"Tabela da Prova por Absurdo\")"
   ]
  },
